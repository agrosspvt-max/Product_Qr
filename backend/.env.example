# --- Database ---------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/product_qr

# --- JWT --------------------------------------------------------------
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Short link domain (overrides DB setting when set) ----------------
SHORT_DOMAIN=https://qr.company.com

# --- Excel export -----------------------------------------------------
EXCEL_EXPORT_DIR=./exports

# --- CORS -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
